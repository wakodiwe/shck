    "correctCode": "if [ -n \"$var\" ]\nthen\n  echo \"var has a value\"\nelse\n  echo \"var is empty\"\nfi\nif [[ -n $var ]]\nthen\n  echo \"var has a value\"\nelse\n  echo \"var is empty\"\nfi"
