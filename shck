    "correctCode": "foo=\"$(mycmd)\"\nexport foo\nlocal foo\nfoo=$(mycmd)\nfoo=\"$(mycmd)\"\nreadonly foo",
    "fix": "Declare and assign separately to avoid masking return values.",
