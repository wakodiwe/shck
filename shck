    "correctCode": "case \"$1\" in\n  -\\?) echo \"Usage: $0 [-n]\";;\n# '-?') echo \"Usage: $0 [-n]\";;  # Also valid\n  -n) echo \"Hello World\";;\n   *) exit 1;;\nesac"
