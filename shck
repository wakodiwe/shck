    "problematicCode": "var=name\nn=42\necho \"$var_$n.jpg\"   # overextended\ntarget=\"world\"\necho \"hello $tagret\"  # misspelled\necho \"Result: ${mycmd -a myfile}\"  # trying to execute commands",
