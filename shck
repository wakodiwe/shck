  "SC2213": {
    "code": "SC2213",
    "title": "getopts specified `-n`, but it's not handled by this `case`.",
    "fix": "getopts specified `-n`, but it's not handled by this `case`.",
    "rationale": "You have a `while getopts` loop where the corresponding `case` statement fails to handle one of the flags.\n\nEither add a case to handle the flag, or remove it from the `getopts` option string.",
